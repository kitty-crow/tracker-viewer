{
  "name": "tracker-viewer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run validate && vite build && bun scripts/build-exe.mts",
    "start": "bun scripts/standalone.mts",
    "serve": "bun scripts/standalone.mts",
    "typecheck": "tsc --noEmit",
    "guard": "bun scripts/guard.mts",
    "test": "bun test",
    "validate": "bun run typecheck && bun run guard && bun test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "@xmldom/xmldom": "^0.9.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
