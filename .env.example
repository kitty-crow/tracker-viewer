# Server listener settings (read at startup; changing these requires restarting the app).
# Use 127.0.0.1 for local-only access. A LAN or wildcard IP exposes the tracker to other devices.
IP=127.0.0.1
PORT=59413

# The server reads this folder on every request. No rebuild required.
# A relative path is resolved from this .env file's directory.
# Leave empty to use ./public automatically.
TRACKER_FOLDER="./public"
